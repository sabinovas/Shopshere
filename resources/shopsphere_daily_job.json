{
  "name": "shopsphere-daily-dev",
  "description": "Placeholders ${WORKING_USER} and ${ALERT_EMAIL} are filled in when the job is created. Daily ShopSphere run: bronze ingestion -> medallion pipeline -> data-quality checks -> dashboard refresh. Clickstream is not included while the Event Hubs namespace is deleted.",
  "tags": { "project": "shopsphere", "env": "dev" },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": ["${ALERT_EMAIL}"],
    "no_alert_for_skipped_runs": true
  },
  "job_clusters": [
    {
      "job_cluster_key": "single_node",
      "new_cluster": {
        "spark_version": "17.3.x-scala2.13",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER",
        "single_user_name": "${WORKING_USER}",
        "spark_conf": {
          "spark.master": "local[*, 4]",
          "spark.databricks.cluster.profile": "singleNode"
        },
        "custom_tags": { "ResourceClass": "SingleNode", "project": "shopsphere" }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_autoloader",
      "description": "Products and sellers from the landing zone (Auto Loader)",
      "job_cluster_key": "single_node",
      "notebook_task": { "notebook_path": "/Users/${WORKING_USER}/shopsphere/bronze/01_autoloader_products_sellers" },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "bronze_jdbc",
      "description": "Orders, customers, payments, items, reviews from Azure SQL (JDBC)",
      "job_cluster_key": "single_node",
      "notebook_task": { "notebook_path": "/Users/${WORKING_USER}/shopsphere/bronze/02_jdbc_orders_customers_payments" },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "medallion_pipeline",
      "description": "Silver and gold (Lakeflow Declarative Pipeline, serverless)",
      "depends_on": [{ "task_key": "bronze_autoloader" }, { "task_key": "bronze_jdbc" }],
      "pipeline_task": { "pipeline_id": "d70869a3-d67e-4b8e-be24-c7b8bbb86915", "full_refresh": false },
      "max_retries": 1,
      "min_retry_interval_millis": 120000
    },
    {
      "task_key": "quality_checks",
      "description": "Expectation results to ops.dq_results; fails on structural problems",
      "depends_on": [{ "task_key": "medallion_pipeline" }],
      "job_cluster_key": "single_node",
      "notebook_task": { "notebook_path": "/Users/${WORKING_USER}/shopsphere/pipelines/08_data_quality_report" }
    },
    {
      "task_key": "refresh_dashboard",
      "description": "Refresh the ShopSphere Executive dashboard",
      "depends_on": [{ "task_key": "quality_checks" }],
      "dashboard_task": {
        "dashboard_id": "01f1cb60104619b093b54723e113bc29",
        "warehouse_id": "efb7c6ee95796af7"
      }
    }
  ]
}
