# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.
# Set the SQL password via environment variable instead:
#   PowerShell:  $env:TF_VAR_sql_admin_password = "..."   (value: Key Vault secret sql-admin-password)
#   Bash:        export TF_VAR_sql_admin_password="..."

subscription_id       = "00000000-0000-0000-0000-000000000000" # Azure subscription 1
databricks_account_id = "00000000-0000-0000-0000-000000000000" # account console
metastore_id         = "00000000-0000-0000-0000-000000000000" # shopsphere-metastore

location    = "centralindia"
environment = "dev"
name_suffix = "27" # makes global names unique: stshopspheredev27, kv-shopsphere-dev27, sql-shopsphere-dev27

sql_client_ip      = "203.0.113.10" # your public IP (https://ifconfig.me)
budget_alert_email = "you@example.com"

databricks_service_principal_id = "00000000-0000-0000-0000-000000000000" # object ID of the AzureDatabricks enterprise app in your tenant
working_user                    = "you@example.com"                      # Databricks user that owns the Git folder
