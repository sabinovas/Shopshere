{
  "datasets": [
    {
      "name": "totals",
      "displayName": "totals",
      "queryLines": [
        "SELECT MEASURE(`Orders`) AS orders, MEASURE(`Gross Revenue`) AS revenue,\n       MEASURE(`Avg Order Value`) AS aov, MEASURE(`Avg Delivery Days`) AS delivery_days,\n       MEASURE(`Late Delivery Rate`) AS late_rate\nFROM shopsphere_dev.gold.sales_metrics"
      ]
    },
    {
      "name": "monthly",
      "displayName": "monthly",
      "queryLines": [
        "SELECT `Order Month` AS month, MEASURE(`Gross Revenue`) AS revenue, MEASURE(`Orders`) AS orders,\n       MEASURE(`Avg Delivery Days`) AS delivery_days, MEASURE(`Late Delivery Rate`) AS late_rate\nFROM shopsphere_dev.gold.sales_metrics\nWHERE `Order Month` >= DATE'2017-01-01' AND `Order Month` < DATE'2018-09-01'\nGROUP BY ALL"
      ]
    },
    {
      "name": "category",
      "displayName": "category",
      "queryLines": [
        "SELECT `Category` AS category, MEASURE(`Gross Revenue`) AS revenue, MEASURE(`Orders`) AS orders\nFROM shopsphere_dev.gold.sales_metrics GROUP BY ALL ORDER BY revenue DESC LIMIT 10"
      ]
    },
    {
      "name": "payment",
      "displayName": "payment",
      "queryLines": [
        "SELECT `Payment Type` AS payment_type, MEASURE(`Gross Revenue`) AS revenue\nFROM shopsphere_dev.gold.sales_metrics WHERE `Payment Type` IS NOT NULL GROUP BY ALL"
      ]
    },
    {
      "name": "seller_state",
      "displayName": "seller state",
      "queryLines": [
        "SELECT `Seller State` AS seller_state, MEASURE(`Avg Delivery Days`) AS delivery_days,\n       MEASURE(`Late Delivery Rate`) AS late_rate, MEASURE(`Orders`) AS orders\nFROM shopsphere_dev.gold.sales_metrics GROUP BY ALL HAVING MEASURE(`Orders`) >= 500 ORDER BY late_rate DESC"
      ]
    },
    {
      "name": "funnel_totals",
      "displayName": "funnel totals",
      "queryLines": [
        "SELECT MEASURE(`Sessions`) AS sessions, MEASURE(`View To Cart Rate`) AS view_to_cart,\n       MEASURE(`Cart To Purchase Rate`) AS cart_to_purchase, MEASURE(`Conversion Rate`) AS conversion\nFROM shopsphere_dev.gold.funnel_metrics"
      ]
    },
    {
      "name": "funnel_stages",
      "displayName": "funnel stages",
      "queryLines": [
        "SELECT stage, sessions FROM (\n  SELECT '1. Viewed' AS stage, SUM(sessions_with_view) AS sessions FROM shopsphere_dev.gold.funnel_conversion\n  UNION ALL SELECT '2. Added to cart', SUM(sessions_with_cart) FROM shopsphere_dev.gold.funnel_conversion\n  UNION ALL SELECT '3. Purchased', SUM(sessions_with_purchase) FROM shopsphere_dev.gold.funnel_conversion)"
      ]
    }
  ],
